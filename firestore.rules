rules_version = '2';

// Regras do App Nelore MRA — colar em Firebase > Firestore Database > Regras > Publicar.
// Ninguém lê nada sem login. Só o administrador cria usuários e muda permissões.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function ehAdmin() { return logado() && request.auth.token.email == 'mandrade.gado@terra.com.br'; }
    function perfil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ativo() {
      return logado() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && perfil().ativo == true;
    }
    function podeApp(app) { return ehAdmin() || (ativo() && perfil().apps[app] == true); }

    // Usuários e permissões: cada um lê o próprio; só o admin cria/edita.
    match /users/{uid} {
      allow read: if ehAdmin() || (logado() && request.auth.uid == uid);
      allow write: if ehAdmin();
    }

    // Nome de usuário -> e-mail interno do login (usado na tela de entrar, antes do login).
    match /logins/{usuario} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Configurações gerais (links dos apps etc.)
    match /config/{doc} {
      allow read: if ehAdmin() || ativo();
      allow write: if ehAdmin();
    }

    // Custos: quem só tem telas de Diesel acessa SÓ o diesel (nunca os custos da safra).
    function custosCompleto() {
      return ehAdmin() || !('paginas' in perfil()) || !('custos' in perfil().paginas)
        || perfil().paginas.custos.size() == 0
        || perfil().paginas.custos.hasAny(['dashboard','colheita','adiantamentos','vendas','cadastros','safras']);
    }
    match /apps/custos/dados/{doc} {
      allow read, write: if podeApp('custos') && (doc == 'diesel' || custosCompleto());
    }

    // Caderneta: todos com acesso leem e lançam; só quem lançou (ou o admin) altera/apaga.
    function donoOuAdmin() { return ehAdmin() || resource.data.criadoPorUid == request.auth.uid; }
    match /apps/caderneta/lancamentos/{id} {
      allow read: if podeApp('caderneta');
      allow create: if podeApp('caderneta') && request.resource.data.criadoPorUid == request.auth.uid;
      allow update, delete: if podeApp('caderneta') && donoOuAdmin();
    }
    match /apps/caderneta/fotos/{id} {
      allow read: if podeApp('caderneta');
      allow create: if podeApp('caderneta') && request.resource.data.criadoPorUid == request.auth.uid;
      allow update, delete: if podeApp('caderneta') && donoOuAdmin();
    }
    match /apps/caderneta/config/{doc} {
      allow read, write: if podeApp('caderneta');
    }

    // Dados de cada app ficam em /apps/<app>/... e só quem tem permissão naquele app acessa.
    match /apps/{app}/{resto=**} {
      allow read, write: if app != 'custos' && app != 'caderneta' && podeApp(app);
    }

    // Todo o resto: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
